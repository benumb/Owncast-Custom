#!/usr/bin/env python3
# Cobra HDD Monitor V1.1

import hashlib
import hmac
import json
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

VERSION = "V1.1"
APP_ID = "fr.cobravideoclub.hddmonitor"
BASE = "http://mafreebox.freebox.fr/api/v8"

TOKEN_FILE = Path.home() / ".config/cobra-hdd-monitor/app_token"
STATE_DIR = Path.home() / ".config/cobra-hdd-monitor"
STATE_FILE = STATE_DIR / "history_V1.1.json"

HOST = "0.0.0.0"
PORT = 8787
REFRESH_SECONDS = 30


def get_json(url, headers=None):
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def post_json(url, data, headers=None):
    body = json.dumps(data).encode()
    hdrs = {"Content-Type": "application/json"}
    if headers:
        hdrs.update(headers)

    req = urllib.request.Request(
        url,
        data=body,
        headers=hdrs,
        method="POST"
    )

    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def session_headers():
    token = TOKEN_FILE.read_text().strip()

    login = get_json(f"{BASE}/login/")
    challenge = login["result"]["challenge"]

    password = hmac.new(
        token.encode(),
        challenge.encode(),
        hashlib.sha1
    ).hexdigest()

    session = post_json(
        f"{BASE}/login/session/",
        {
            "app_id": APP_ID,
            "password": password,
        }
    )

    return {
        "X-Fbx-App-Auth": session["result"]["session_token"]
    }


def fmt_bytes(n):
    if not n:
        return "0 B"

    units = ["B", "KB", "MB", "GB", "TB"]
    x = float(n)
    i = 0

    while x >= 1000 and i < len(units) - 1:
        x /= 1000.0
        i += 1

    return f"{x:.2f} {units[i]}"


def pct(used, total):
    if not total:
        return 0

    return round((used / total) * 100, 1)


def load_history():
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    if not STATE_FILE.exists():
        return {}

    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {}


def save_history(history):
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(
        json.dumps(
            history,
            ensure_ascii=False,
            indent=2
        )
    )

    tmp.replace(STATE_FILE)


def fetch_data():
    headers = session_headers()

    disks = get_json(
        f"{BASE}/storage/disk/",
        headers
    )["result"]

    parts = get_json(
        f"{BASE}/storage/partition/",
        headers
    )["result"]

    pmap = {}

    for p in parts:
        pmap.setdefault(
            p.get("disk_id"),
            []
        ).append(p)

    old_history = load_history()
    new_history = {}

    rows = []

    total_errors = 0
    total_new_errors = 0
    active_disks = 0
    alerts = 0

    now = time.strftime("%Y-%m-%d %H:%M:%S")

    for d in disks:

        disk_id = str(d.get("id"))

        plist = (
            pmap.get(
                d.get("id"),
                d.get("partitions", [])
            )
            or []
        )

        labels = [
            p.get("label")
            or f"Partition {p.get('id')}"
            for p in plist
        ]

        mounted = any(
            p.get("state") == "mounted"
            for p in plist
        )

        used = sum(
            int(p.get("used_bytes") or 0)
            for p in plist
        )

        free = sum(
            int(p.get("free_bytes") or 0)
            for p in plist
        )

        total = (
            sum(
                int(p.get("total_bytes") or 0)
                for p in plist
            )
            or int(d.get("total_bytes") or 0)
        )

        read_errors = int(
            d.get("read_error_requests") or 0
        )

        write_errors = int(
            d.get("write_error_requests") or 0
        )

        io_errors = (
            read_errors +
            write_errors
        )

        state = d.get(
            "state",
            "unknown"
        )

        temp = d.get("temp") or 0

        previous = old_history.get(
            disk_id,
            {}
        )

        previous_read = int(
            previous.get(
                "read_errors",
                read_errors
            )
        )

        previous_write = int(
            previous.get(
                "write_errors",
                write_errors
            )
        )

        new_read_errors = max(
            0,
            read_errors - previous_read
        )

        new_write_errors = max(
            0,
            write_errors - previous_write
        )

        new_errors = (
            new_read_errors +
            new_write_errors
        )

        if state == "enabled":
            active_disks += 1

        total_errors += io_errors
        total_new_errors += new_errors

        if new_errors > 0:
            health = "nouvelle_alerte"
            alerts += 1

        elif io_errors > 0:
            health = "alerte"
            alerts += 1

        elif state == "enabled" and (
            mounted or not plist
        ):
            health = "ok"

        elif state == "disabled":
            health = "inactif"

        else:
            health = "attention"
            alerts += 1

        new_history[disk_id] = {
            "read_errors": read_errors,
            "write_errors": write_errors,
            "last_seen": now,
        }

        rows.append({
            "id": d.get("id"),

            "label":
                " / ".join(labels)
                if labels
                else (
                    d.get("model")
                    or f"Disque {d.get('id')}"
                ),

            "model":
                d.get("model")
                or "N/A",

            "serial":
                d.get("serial")
                or "N/A",

            "type":
                d.get("type")
                or "N/A",

            "state": state,
            "mounted": mounted,

            "temp":
                temp
                if temp > 0
                else None,

            "read_errors":
                read_errors,

            "write_errors":
                write_errors,

            "new_read_errors":
                new_read_errors,

            "new_write_errors":
                new_write_errors,

            "new_errors":
                new_errors,

            "io_errors":
                io_errors,

            "total":
                total,

            "used":
                used,

            "free":
                free,

            "used_pct":
                pct(
                    used,
                    total
                ),

            "health":
                health,

            "partitions":
                plist,
        })

    save_history(new_history)

    return {
        "version": VERSION,
        "generated_at": now,

        "summary": {
            "active_disks": active_disks,
            "alerts": alerts,
            "total_errors": total_errors,
            "new_errors": total_new_errors,
        },

        "rows": rows,
    }


def esc(s):
    return (
        str(s)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


