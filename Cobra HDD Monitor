import hashlib
import hmac
import json
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


# ============================================================
# CONFIGURATION
# ============================================================

VERSION = "V1.1"

APP_ID = "fr.cobravideoclub.hddmonitor"
BASE = "http://mafreebox.freebox.fr/api/v8"

TOKEN_FILE = (
    Path.home()
    / ".config"
    / "cobra-hdd-monitor"
    / "app_token"
)

STATE_DIR = (
    Path.home()
    / ".config"
    / "cobra-hdd-monitor"
)

STATE_FILE = STATE_DIR / "history.json"

HOST = "0.0.0.0"
PORT = 8787

REFRESH_SECONDS = 30


# ============================================================
# FREEBOX API
# ============================================================

def get_json(url, headers=None):

    req = urllib.request.Request(
        url,
        headers=headers or {}
    )

    with urllib.request.urlopen(
        req,
        timeout=10
    ) as response:

        return json.load(response)


def post_json(url, data, headers=None):

    body = json.dumps(data).encode()

    request_headers = {
        "Content-Type": "application/json"
    }

    if headers:
        request_headers.update(headers)

    req = urllib.request.Request(
        url,
        data=body,
        headers=request_headers,
        method="POST"
    )

    with urllib.request.urlopen(
        req,
        timeout=10
    ) as response:

        return json.load(response)


def session_headers():

    token = TOKEN_FILE.read_text().strip()

    login = get_json(
        f"{BASE}/login/"
    )

    challenge = login["result"]["challenge"]

    password = hmac.new(
        token.encode(),
        challenge.encode(),
        hashlib.sha1
    ).hexdigest()

    session = post_json(
        f"{BASE}/login/session/",
        {
            "app_id": APP_ID,
            "password": password
        }
    )

    if not session.get("success"):

        raise RuntimeError(
            "Impossible d'ouvrir une session Freebox"
        )

    session_token = (
        session["result"]["session_token"]
    )

    return {
        "X-Fbx-App-Auth": session_token
    }


# ============================================================
# OUTILS
# ============================================================

def format_bytes(value):

    if not value:
        return "0 B"

    units = [
        "B",
        "KB",
        "MB",
        "GB",
        "TB"
    ]

    number = float(value)
    index = 0

    while (
        number >= 1000
        and index < len(units) - 1
    ):

        number /= 1000
        index += 1

    return (
        f"{number:.2f} "
        f"{units[index]}"
    )


def percentage(used, total):

    if not total:
        return 0

    return round(
        (used / total) * 100,
        1
    )


def escape_html(value):

    return (
        str(value)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


# ============================================================
# HISTORIQUE
# ============================================================

def load_history():

    STATE_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    if not STATE_FILE.exists():
        return {}

    try:

        return json.loads(
            STATE_FILE.read_text()
        )

    except Exception:

        return {}


def save_history(history):

    STATE_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    temporary_file = (
        STATE_FILE.with_suffix(".tmp")
    )

    temporary_file.write_text(
        json.dumps(
            history,
            ensure_ascii=False,
            indent=2
        )
    )

    temporary_file.replace(
        STATE_FILE
    )


# ============================================================
# RÉCUPÉRATION DES DISQUES
# ============================================================

def fetch_data():

    headers = session_headers()

    disk_response = get_json(
        f"{BASE}/storage/disk/",
        headers
    )

    partition_response = get_json(
        f"{BASE}/storage/partition/",
        headers
    )

    if not disk_response.get("success"):

        raise RuntimeError(
            "Impossible de récupérer les disques"
        )

    if not partition_response.get("success"):

        raise RuntimeError(
            "Impossible de récupérer les partitions"
        )

    disks = disk_response["result"]

    partitions = partition_response["result"]

    partitions_by_disk = {}

    for partition in partitions:

        disk_id = partition.get("disk_id")

        partitions_by_disk.setdefault(
            disk_id,
            []
        ).append(partition)


    old_history = load_history()

    new_history = {}

    rows = []

    active_disks = 0
    total_errors = 0
    total_new_errors = 0
    alerts = 0

    now = time.strftime(
        "%d/%m/%Y %H:%M:%S"
    )


    for disk in disks:

        disk_id = disk.get("id")

        disk_key = str(disk_id)

        disk_partitions = (
            partitions_by_disk.get(
                disk_id,
                []
            )
        )


        # ----------------------------------------------------
        # LABEL
        # ----------------------------------------------------

        labels = []

        for partition in disk_partitions:

            label = partition.get("label")

            if label:
                labels.append(label)

        if labels:

            label = " / ".join(labels)

        elif disk.get("model"):

            label = disk.get("model")

        else:

            label = f"Disque {disk_id}"


        # ----------------------------------------------------
        # MONTAGE
        # ----------------------------------------------------

        mounted = any(
            partition.get("state") == "mounted"
            for partition in disk_partitions
        )


        # ----------------------------------------------------
        # ESPACE
        # ----------------------------------------------------

        used = sum(
            int(
                partition.get(
                    "used_bytes"
                ) or 0
            )
            for partition
            in disk_partitions
        )

        free = sum(
            int(
                partition.get(
                    "free_bytes"
                ) or 0
            )
            for partition
            in disk_partitions
        )

        partition_total = sum(
            int(
                partition.get(
                    "total_bytes"
                ) or 0
            )
            for partition
            in disk_partitions
        )

        if partition_total:

            total = partition_total

        else:

            total = int(
                disk.get(
                    "total_bytes"
                ) or 0
            )


        used_percent = percentage(
            used,
            total
        )


        # ----------------------------------------------------
        # ERREURS
        # ----------------------------------------------------

        read_errors = int(
            disk.get(
                "read_error_requests"
            ) or 0
        )

        write_errors = int(
            disk.get(
                "write_error_requests"
            ) or 0
        )

        io_errors = (
            read_errors
            + write_errors
        )


        # ----------------------------------------------------
        # HISTORIQUE ERREURS
        # ----------------------------------------------------

        previous = old_history.get(
            disk_key,
            {}
        )

        previous_read = int(
            previous.get(
                "read_errors",
                read_errors
            )
        )

        previous_write = int(
            previous.get(
                "write_errors",
                write_errors
            )
        )

        new_read_errors = max(
            0,
            read_errors - previous_read
        )

        new_write_errors = max(
            0,
            write_errors - previous_write
        )

        new_errors = (
            new_read_errors
            + new_write_errors
        )


        # ----------------------------------------------------
        # ÉTAT
        # ----------------------------------------------------

        state = disk.get(
            "state",
            "unknown"
        )

        temperature = int(
            disk.get("temp") or 0
        )


        # ----------------------------------------------------
        # DÉTERMINATION SANTÉ
        # ----------------------------------------------------

        if state == "enabled":

            active_disks += 1


        total_errors += io_errors

        total_new_errors += new_errors


        if new_errors > 0:

            health = "alert"

            health_text = "ALERTE"

            alerts += 1


        elif io_errors > 0:

            health = "alert"

            health_text = "ALERTE"

            alerts += 1


        elif (
            state == "enabled"
            and mounted
        ):

            health = "ok"

            health_text = "OK"


        elif state == "disabled":

            health = "inactive"

            health_text = "INACTIF"


        else:

            health = "alert"

            health_text = "ALERTE"

            alerts += 1


        # ----------------------------------------------------
        # HISTORIQUE
        # ----------------------------------------------------

        new_history[disk_key] = {

            "read_errors":
                read_errors,

            "write_errors":
                write_errors,

            "last_seen":
                now

        }


        # ----------------------------------------------------
        # DONNÉES POUR INTERFACE
        # ----------------------------------------------------

        rows.append({

            "id":
                disk_id,

            "label":
                label,

            "model":
                disk.get("model")
                or "N/A",

            "serial":
                disk.get("serial")
                or "N/A",

            "type":
                disk.get("type")
                or "N/A",

            "state":
                state,

            "mounted":
                mounted,

            "temperature":
                (
                    temperature
                    if temperature > 0
                    else None
                ),

            "read_errors":
                read_errors,

            "write_errors":
                write_errors,

            "new_read_errors":
                new_read_errors,

            "new_write_errors":
                new_write_errors,

            "new_errors":
                new_errors,

            "io_errors":
                io_errors,

            "total":
                total,

            "used":
                used,

            "free":
                free,

            "used_percent":
                used_percent,

            "health":
                health,

            "health_text":
                health_text

        })


    save_history(
        new_history
    )


    return {

        "version":
            VERSION,

        "generated_at":
            now,

        "summary": {

            "active_disks":
                active_disks,

            "alerts":
                alerts,

            "total_errors":
                total_errors,

            "new_errors":
                total_new_errors

        },

        "rows":
            rows

    }


