# ============================================================
# SERVEUR WEB
# ============================================================

class Handler(BaseHTTPRequestHandler):

    def do_GET(self):

        if self.path not in (
            "/",
            "/index.html",
            "/api.json"
        ):

            self.send_error(404)

            return


        try:

            data = fetch_data()


            # ------------------------------------------------
            # API JSON
            # ------------------------------------------------

            if self.path == "/api.json":

                payload = json.dumps(
                    data,
                    ensure_ascii=False,
                    indent=2
                ).encode()

                content_type = (
                    "application/json; "
                    "charset=utf-8"
                )


            # ------------------------------------------------
            # PAGE HTML
            # ------------------------------------------------

            else:

                payload = render_html(
                    data
                ).encode()

                content_type = (
                    "text/html; "
                    "charset=utf-8"
                )


            self.send_response(200)

            self.send_header(
                "Content-Type",
                content_type
            )

            self.send_header(
                "Content-Length",
                str(len(payload))
            )

            self.send_header(
                "Cache-Control",
                "no-store"
            )

            self.end_headers()

            self.wfile.write(
                payload
            )


        except Exception as error:

            payload = (
                "Erreur Cobra HDD Monitor : "
                f"{error}\n"
            ).encode()

            self.send_response(500)

            self.send_header(
                "Content-Type",
                "text/plain; charset=utf-8"
            )

            self.send_header(
                "Content-Length",
                str(len(payload))
            )

            self.end_headers()

            self.wfile.write(
                payload
            )


    def log_message(
        self,
        fmt,
        *args
    ):

        print(
            time.strftime(
                "%Y-%m-%d %H:%M:%S"
            ),
            self.client_address[0],
            fmt % args
        )


# ============================================================
# DÉMARRAGE
# ============================================================

if __name__ == "__main__":

    if not TOKEN_FILE.exists():

        raise SystemExit(
            "Token Freebox introuvable : "
            f"{TOKEN_FILE}"
        )


    print(
        f"Cobra HDD Monitor {VERSION}"
    )

    print(
        f"http://{HOST}:{PORT}"
    )


    server = ThreadingHTTPServer(
        (HOST, PORT),
        Handler
    )

    server.serve_forever()
